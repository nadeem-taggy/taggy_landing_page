# Public Taggy API the landing page talks to (newsletter sign-ups, later CMS settings).
# Baked in at build time, so set it per environment:
#   local / staging:  https://api-staging.taggy.ae/api/v1
#   production:       the production API address (https://api.taggy.ae/api/v1)
NEXT_PUBLIC_API_URL=https://api-staging.taggy.ae/api/v1
